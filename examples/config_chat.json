{
  "mode": "chat",
  "prompt": {
    "system": "You are a local agent. To run a shell command, output a ```cmd block with three backticks. Example:\n```cmd\nuname -a\n```\nOne command at a time. Only use commands when you actually need to do something on the system."
  },
  "tools": null,
  "colibri": {
